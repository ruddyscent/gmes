include VERSION README.md LICENSE CHANGELOG.md CONTRIBUTING.md SECURITY.md build-constraints.txt gmes/py.typed gmes/*.pyi
recursive-include src *.cc *.hh *.i
recursive-include examples README *.md *.py
recursive-include tests README *.py
recursive-include utils *.py
recursive-include benchmarks README.md *.json *.py
exclude benchmarks/evidence/issue-123/torch-cpu-baseline-one.json
exclude benchmarks/evidence/issue-123/torch-cpu-baseline-physical.json
recursive-include docs *.md
exclude gmes/constant.py
exclude gmes/pw_material.py
exclude src/constant.py
exclude src/material.c
exclude src/material.cpp
exclude src/pw_material.py
