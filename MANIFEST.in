include VERSION README.md LICENSE CHANGELOG.md CONTRIBUTING.md SECURITY.md build-constraints.txt gmes/py.typed gmes/constant.py gmes/constant.pyi
recursive-include examples README *.md *.py
recursive-include tests README *.py
recursive-include tests/fixtures/issue124 *
